# Template for the local .env file. Copy it ONLY when .env does not exist yet:
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }      # PowerShell
#   [ -f .env ] || cp .env.example .env                            # bash
# Overwriting an existing .env with this template silently wipes LLM_API_KEY
# (it has happened once: .env ended up byte-identical to this file).
# This file is tracked by git: never put a real key here.

# Phase 0: Quant Engine (all paths optional; defaults point to repo-local dirs)
# FINANCE_DATA_DIR=
# FINANCE_MODEL_DIR=
# FINANCE_LOG_DIR=
# FINANCE_DB_PATH=
# FINANCE_MODEL_VERSION=xgb-b-20260625-fulla

# Phase 1+ (RAG / Agent / LLM) -- not used in Phase 0
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# Phase 2: embeddings + vector store
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cuda            # cuda | cpu | auto (falls back to cpu with a warning)
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_VERSION=bge-m3-v1      # bump whenever the model/weights/precision change
# EMBEDDING_DIM=1024
# QDRANT_PATH=data/qdrant          # local (embedded) mode
#
# QDRANT_URL -- set it explicitly. Leave it unset and every host-side script and
# the local API silently switch to local (embedded) mode on data/qdrant, whose
# stale copy holds the SAME 109,554 points: the point count cannot tell the two
# stores apart, and date filters may simply return nothing. Prefer the server:
# QDRANT_URL=http://localhost:6333 # Docker Qdrant service (docker compose up -d qdrant)
#   Inside the api container this value is overridden by docker-compose's
#   `environment:` (http://qdrant:6333), which takes precedence over this file.
# QDRANT_COLLECTION=financial_chunks
# HF_ENDPOINT=https://hf-mirror.com  # model download mirror (China)
